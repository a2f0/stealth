{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tearleads-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "AUTH_EMAIL_FROM": "security@auth.tearleads.com",
    "BETTER_AUTH_URL": "https://api.tearleads.com",
    "CORS_ORIGIN": "https://app.tearleads.com",
    "INBOUND_EMAIL_DOMAIN": "inbox.tearleads.com",
    "PLAID_ENV": "sandbox",
    "PLAID_REDIRECT_URI": "https://app.tearleads.com/finance"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Cloudflare D1 names are immutable; retain the original resource name.
      "database_name": "stealth-db",
      "database_id": "d2827a94-7088-4648-9b57-5f915da2b909",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      // R2 buckets cannot be renamed; retain the existing data-bearing bucket.
      "bucket_name": "stealth-objects"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["security@auth.tearleads.com"]
    }
  ]
}
