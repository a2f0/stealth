---
import { legalLinks, productName } from "@tearleads/ui/brand";
import BaseLayout from "./BaseLayout.astro";
import "../styles/legal.css";

interface Props {
  description: string;
  eyebrow: string;
  title: string;
  updated: string;
}

const { description, eyebrow, title, updated } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "");
---

<BaseLayout description={description} title={`${title} — ${productName}`}>
  <header class="legalHero">
    <div class="container legalContainer">
      <div class="legalHeroText">
        <p class="eyebrow eyebrowDot">{eyebrow}</p>
        <h1 class="title">{title}</h1>
        <p class="lead">{description}</p>
        <p class="legalEffective">Effective {updated}</p>
      </div>
      <nav aria-label="Policies" class="tabs legalTabs">
        {
          legalLinks.map((link) => (
            <a
              aria-current={currentPath === link.href ? "page" : undefined}
              class="tab"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </header>
  <div class="container legalContainer">
    <article class="prose legalDocument">
      <slot />
    </article>
  </div>
</BaseLayout>
