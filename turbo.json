{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "STAGING_STRIPE_PORTAL_CONFIGURATION_ID",
    "TEARLEADS_PREFLIGHT_OFFLINE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
