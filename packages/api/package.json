{
  "name": "@tearleads/api",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "dev": "bash ../../scripts/devApi.sh",
    "test": "bun test"
  },
  "dependencies": {
    "better-auth": "1.7.0",
    "hono": "4.13.2",
    "pdf-lib": "1.17.1",
    "postal-mime": "3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260817.1",
    "@types/bun": "1.3.11",
    "miniflare": "5.20260811.1-alpha"
  }
}
