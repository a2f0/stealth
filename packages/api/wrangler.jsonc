{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "balebase-api",
  "main": "src/index.ts",
  // Preserve the pre-4.150 upload policy; staging inherits this setting.
  "upload_source_maps": false,
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "AUTH_EMAIL_FROM": "security@auth.balebase.com",
    "BETTER_AUTH_URL": "https://api.balebase.com",
    "CORS_ORIGIN": "https://app.balebase.com",
    "CHECKR_ENV": "production",
    "INBOUND_EMAIL_DOMAIN": "inbox.balebase.com",
    "PLAID_ENV": "production",
    "PLAID_REDIRECT_URI": "https://app.balebase.com/finance",
    "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1U8gHBB19gR8AJxmNFLm8BVk",
    "STRIPE_PRO_LEGACY_PRICE_IDS": "",
    "STRIPE_PRO_PRICE_ID": "price_1U8fg7B19gR8AJxmpcqsWGg8",
    // Empty keeps production on Stripe-hosted Checkout until its account's
    // live publishable key is set here.
    "STRIPE_PUBLISHABLE_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "balebase-db",
      "database_id": "c661323d-a9f3-4658-9001-59591cea9208",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "balebase-objects"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["security@auth.balebase.com"]
    }
  ]
}
