{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tearleads-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "AUTH_EMAIL_FROM": "security@auth.tearleads.de",
    "BETTER_AUTH_URL": "https://api.tearleads.de",
    "CORS_ORIGIN": "https://app.tearleads.de",
    "CHECKR_ENV": "production",
    "INBOUND_EMAIL_DOMAIN": "inbox.tearleads.de",
    "PLAID_ENV": "sandbox",
    "PLAID_REDIRECT_URI": "https://app.tearleads.de/finance",
    "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1U8gHBB19gR8AJxmNFLm8BVk",
    "STRIPE_PRO_LEGACY_PRICE_IDS": "",
    "STRIPE_PRO_PRICE_ID": "price_1U8fg7B19gR8AJxmpcqsWGg8",
    // Empty keeps production on Stripe-hosted Checkout until its account's
    // live publishable key is set here.
    "STRIPE_PUBLISHABLE_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Cloudflare D1 names are immutable; retain the original resource name.
      "database_name": "stealth-db",
      "database_id": "d2827a94-7088-4648-9b57-5f915da2b909",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      // R2 buckets cannot be renamed; retain the existing data-bearing bucket.
      "bucket_name": "stealth-objects"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["security@auth.tearleads.de"]
    }
  ]
}
