---
/*
 * Renders a name from @tearleads/ui/icons with the same markup as the
 * client's React <Icon>, so both apps draw identical glyphs.
 */
import { type IconName, icons } from "@tearleads/ui/icons";

interface Props {
  class?: string | undefined;
  name: IconName;
  size?: number | undefined;
}

// The site's icons are decorative; labelled icons exist only in the client.
const { class: className, name, size = 18 } = Astro.props;
---

<svg
  aria-hidden="true"
  class:list={["icon", className]}
  fill="none"
  focusable="false"
  height={size}
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="1.75"
  viewBox="0 0 24 24"
  width={size}
  xmlns="http://www.w3.org/2000/svg"
>
  {icons[name].map(([Tag, attributes]) => <Tag {...attributes} />)}
</svg>
