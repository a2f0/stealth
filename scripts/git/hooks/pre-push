#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# A copied hook must match the checked-out version before it can gate a push.
if ! cmp -s "$0" "$REPO_ROOT/scripts/git/hooks/pre-push"; then
  echo "Error: pre-push hook is stale. Run sh scripts/git/install-hooks.sh." >&2
  exit 1
fi

cd "$REPO_ROOT"

zero_sha="0000000000000000000000000000000000000000"

# Git passes one "<local ref> <local sha> <remote ref> <remote sha>" line per
# pushed ref on stdin.
pushed_refs=""
if [ ! -t 0 ]; then
  pushed_refs=$(cat)
fi

# Cheapest gate first: every pushed commit must be signed and carry no
# Co-authored-by trailer. Deletions push no commits and are skipped.
echo "Checking commit signatures and co-authors..."
while read -r _ local_sha _ remote_sha; do
  if [ -z "$local_sha" ] || [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero_sha" ]; then
    range="main..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  "$REPO_ROOT/scripts/checks/checkCommitTrust.sh" --range "$range" </dev/null
done <<REFS
$pushed_refs
REFS

echo "Running repository checks..."
bun run check

echo "Running tests..."
bun run test

echo "All checks passed."
