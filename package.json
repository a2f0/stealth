{
  "name": "balebase",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "agent-tool": "agent-tool",
    "agent:logs": "bunx --bun --no-install agent-tool logs",
    "agent:run": "bunx --bun --no-install agent-tool run",
    "agents:check": "bun run agent-tool skills check",
    "agents:sync": "bun run agent-tool skills install --apply",
    "auth:set-role": "bash scripts/setUserRole.sh",
    "build": "bunx --bun --no-install turbo run build",
    "check": "export OPENSSL_CONF=/dev/null; bun --bun run lint && bunx --bun --no-install turbo run check && bun --bun run check:scripts",
    "check:fast": "export OPENSSL_CONF=/dev/null; bun --bun run lint:biome && bun --bun run lint:markdown && bun --bun run lint:files && bunx --bun --no-install turbo run check && bun --bun run check:scripts",
    "check:scripts": "bunx --bun --no-install tsc --noEmit --project scripts/tsconfig.json",
    "deploy": "bash scripts/deployProduction.sh",
    "deploy:api": "bash scripts/deployApi.sh",
    "deploy:app": "bash scripts/deployApp.sh",
    "deploy:domains": "bash scripts/configureProductionDomains.sh",
    "deploy:email:verify": "bash scripts/verifyInboundEmail.sh",
    "deploy:staging": "bash scripts/deployStaging.sh",
    "deploy:verify": "bash scripts/verifyProduction.sh",
    "deploy:website": "bash scripts/deployWebsite.sh",
    "dev": "bunx --bun --no-install turbo run dev",
    "emails:purge": "bash scripts/purgeEmails.sh",
    "format": "bun --bun run lint:biome:fix && bun --bun run lint:markdown:fix",
    "hooks:install": "sh scripts/git/install-hooks.sh",
    "images": "agent-tool images build native && agent-tool images build favicons --out packages/ui/dist/images/web",
    "install:dependencies": "bun --bun run bun install",
    "lint": "bun --bun run lint:biome && bun --bun run lint:markdown && bun --bun run lint:files && bun --bun run lint:knip:all && bun --bun run lint:knip:production && bun --bun run lint:scripts && bun --bun run lint:terraform",
    "lint:biome": "bunx --bun --no-install biome check --error-on-warnings .",
    "lint:biome:fix": "bunx --bun --no-install biome check --write --error-on-warnings .",
    "lint:commit-msg": "bunx --bun --no-install commitlint --config commitlint.config.mts --edit",
    "lint:files": "bunx --bun --no-install ls-lint",
    "lint:knip:all": "bunx --bun --no-install knip",
    "lint:knip:dependencies": "bunx --bun --no-install knip --dependencies",
    "lint:knip:exports": "bunx --bun --no-install knip --exports",
    "lint:knip:files": "bunx --bun --no-install knip --files",
    "lint:knip:production": "bunx --bun --no-install knip --production",
    "lint:markdown": "bun --bun x markdownlint-cli2 '**/*.md'",
    "lint:markdown:fix": "bun --bun x markdownlint-cli2 --fix '**/*.md'",
    "lint:scripts": "shellcheck scripts/*.sh scripts/checks/*.sh scripts/git/hooks/* terraform/scripts/*.sh",
    "lint:staged": "bunx --bun --no-install lint-staged",
    "lint:terraform": "bash scripts/checks/checkTerraform.sh",
    "mobile:android": "bun run --cwd packages/client mobile:android",
    "mobile:build:android": "bash scripts/buildAndroid.sh",
    "mobile:build:android:release": "bash scripts/buildAndroidRelease.sh",
    "mobile:build:ios": "bash scripts/buildIos.sh",
    "mobile:build:ios:release": "bash scripts/buildIosRelease.sh",
    "mobile:ios": "bun run --cwd packages/client mobile:ios",
    "mobile:run:android": "bash scripts/runAndroid.sh",
    "mobile:run:ios": "bash scripts/runIos.sh",
    "mobile:sync": "bun run --cwd packages/client mobile:sync",
    "organizations:objects:reorganize": "bash scripts/reorganizeOrganizationObjects.sh",
    "organizations:purge": "bash scripts/purgeOrganizations.sh",
    "terraform:apply": "bash terraform/scripts/run.sh apply",
    "terraform:plan": "bash terraform/scripts/run.sh plan",
    "terraform:staging:apply": "bash terraform/scripts/run.sh staging apply",
    "terraform:staging:plan": "bash terraform/scripts/run.sh staging plan",
    "terraform:validate": "bash terraform/scripts/run.sh validate",
    "test": "export OPENSSL_CONF=/dev/null; bunx --bun --no-install turbo run test && bun --bun run test:staging && bun --bun run test:env && bun --bun run test:markdownlint && bun --bun run test:images",
    "test:env": "bash scripts/checks/testCloudflareEnv.sh",
    "test:images": "bun test scripts/checks/brandImages.test.ts",
    "test:markdownlint": "bun test scripts/checks/markdownlintConfig.test.ts",
    "test:staging": "bash scripts/checks/testDeployStaging.sh"
  },
  "workspaces": [
    "packages/*"
  ],
  "lint-staged": {
    "*.{astro,css,html,js,json,jsonc,jsx,mjs,cjs,ts,tsx}": "bunx --bun --no-install biome check --fix --error-on-warnings",
    "*.md": "bun --bun x markdownlint-cli2 --fix"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.14",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@ls-lint/ls-lint": "2.3.2",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.3",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "wrangler": "4.151.1"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "overrides": {
    "markdownlint-cli2@0.23.3": {
      "smol-toml": "1.9.1"
    },
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    }
  },
  "patchedDependencies": {
    "markdownlint@0.41.1": "patches/markdownlint@0.41.1.patch"
  }
}
