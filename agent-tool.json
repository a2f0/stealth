{
  "schemaVersion": 1,
  "subject": {
    "maxLength": 50,
    "types": [
      "build",
      "chore",
      "ci",
      "cleanup",
      "docs",
      "feat",
      "fix",
      "perf",
      "refactor",
      "revert",
      "style",
      "test"
    ]
  },
  "merge": {
    "requiredChecks": [{ "name": "Check, test, and build", "workflow": "CI" }],
    "requireStrictBaseFreshness": true
  },
  "versions": {
    "packages": ["packages/api", "packages/client"]
  },
  "pr": { "rejectClaudeBranding": true },
  "images": {
    "targets": {
      "favicons": {
        "outputs": [
          { "path": "favicon.svg", "layers": [{ "source": "logo" }] },
          {
            "path": "favicon.ico",
            "sizes": [16, 32, 48],
            "layers": [{ "source": "logo", "pixelSnap": true }]
          },
          {
            "path": "apple-touch-icon.png",
            "size": 180,
            "opaque": true,
            "layers": [
              { "fill": "#b7ff5b" },
              { "source": "logo", "scale": 0.8, "pixelSnap": true }
            ]
          }
        ]
      },
      "native": {
        "dir": "packages/ui/dist/images",
        "outputs": [
          {
            "path": "ios/App/App/Assets.xcassets/AppIcon.appiconset/AppIcon-512@2x.png",
            "size": 1024,
            "opaque": true,
            "layers": [
              { "fill": "#b7ff5b" },
              { "source": "logo", "scale": 0.75, "pixelSnap": true }
            ]
          },
          {
            "path": "ios/App/App/Assets.xcassets/Splash.imageset/splash{variant}.png",
            "size": 2732,
            "variants": { "": 1, "@2x": 1, "@3x": 1 },
            "opaque": true,
            "layers": [
              { "fill": "#181916" },
              { "source": "logo", "scale": 0.2, "pixelSnap": true }
            ]
          },
          {
            "path": "android/app/src/main/res/values/ic_launcher_background.xml",
            "colors": { "ic_launcher_background": "#b7ff5b" }
          },
          {
            "path": "android/app/src/main/res/mipmap-{variant}/ic_launcher.png",
            "size": 48,
            "variants": "android",
            "opaque": true,
            "layers": [
              { "fill": "#b7ff5b" },
              { "source": "logo", "scale": 0.7, "pixelSnap": true }
            ]
          },
          {
            "path": "android/app/src/main/res/mipmap-{variant}/ic_launcher_round.png",
            "size": 48,
            "variants": "android",
            "opaque": true,
            "layers": [
              { "fill": "#b7ff5b" },
              { "source": "logo", "scale": 0.5, "pixelSnap": true }
            ]
          },
          {
            "path": "android/app/src/main/res/mipmap-{variant}/ic_launcher_foreground.png",
            "size": 108,
            "variants": "android",
            "layers": [{ "source": "logo", "scale": 0.6, "pixelSnap": true }]
          },
          {
            "path": "android/app/src/main/res/drawable-{variant}/splash.png",
            "variants": {
              "mdpi": [320, 480],
              "land-mdpi": [480, 320],
              "land-hdpi": [800, 480],
              "land-xhdpi": [1280, 720],
              "land-xxhdpi": [1600, 960],
              "land-xxxhdpi": [1920, 1280],
              "port-mdpi": [320, 480],
              "port-hdpi": [480, 800],
              "port-xhdpi": [720, 1280],
              "port-xxhdpi": [960, 1600],
              "port-xxxhdpi": [1280, 1920]
            },
            "opaque": true,
            "layers": [
              { "fill": "#181916" },
              { "source": "logo", "scale": 0.3, "pixelSnap": true }
            ]
          },
          {
            "path": "plaid/icon-1024.png",
            "size": 1024,
            "opaque": true,
            "layers": [
              { "fill": "#b7ff5b" },
              { "source": "logo", "scale": 0.75, "pixelSnap": true }
            ]
          }
        ]
      }
    }
  }
}
